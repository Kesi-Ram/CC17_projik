<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mint"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="List your items"
            android:textColor="@android:color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Card 1: basic info -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    style="@style/FormLabel"
                    android:text="Listing title" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FormField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Iphone 13 Pro max"
                        android:inputType="textCapWords"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/FormLabel"
                    android:text="Category" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FormField.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actvCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Select category"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/FormLabel"
                    android:text="Price" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FormField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="$0.00"
                        android:inputType="numberDecimal"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/FormLabel"
                    android:text="Location" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FormField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter location"
                        android:inputType="textPostalAddress"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: condition + notes -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    style="@style/FormLabel"
                    android:layout_marginTop="0dp"
                    android:text="Condition" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCondition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="0dp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        style="@style/ConditionChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New/Sealed" />

                    <com.google.android.material.chip.Chip
                        style="@style/ConditionChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good Condition" />

                    <com.google.android.material.chip.Chip
                        style="@style/ConditionChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Used" />

                    <com.google.android.material.chip.Chip
                        style="@style/ConditionChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Needs repair/parts only" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    style="@style/FormLabel"
                    android:layout_marginTop="24dp"
                    android:text="Description/issues/Notes/\nRecommendations" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FormField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="Example:Needs LCD replacement"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 3: photos -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    style="@style/FormLabel"
                    android:layout_marginTop="0dp"
                    android:text="Photos of your item" />

                <LinearLayout
                    android:id="@+id/btnAddPhotos"
                    android:layout_width="145dp"
                    android:layout_height="145dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="48dp"
                    android:background="@drawable/bg_photo_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_photo_camera" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Add photos"
                        android:textColor="@android:color/black" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublish"
            style="@style/ActionButton"
            android:layout_marginTop="24dp"
            android:text="Publish listing"
            app:icon="@drawable/ic_send" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDraft"
            style="@style/ActionButton"
            android:text="Save as draft"
            app:icon="@drawable/ic_inventory" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/ActionButton.Outlined"
            android:text="Cancel"
            app:icon="@drawable/ic_close" />
    </LinearLayout>
</ScrollView>