<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mint"
    android:clipToPadding="false"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/ui_list_your_items"
            android:textColor="@android:color/black"
            android:textSize="24sp"
            android:textStyle="bold" />
        <!-- Card 1: basic info -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">
                <TextView
                    style="@style/FormLabel"
                    android:text="@string/ui_listing_title" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FormField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ui_e_g_iphone_13_pro_max"
                        android:inputType="textCapWords"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/FormLabel"
                    android:text="@string/category" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FormField.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actvCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ui_select_category"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/FormLabel"
                    android:text="@string/price" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FormField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ui_0_00"
                        android:inputType="numberDecimal"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/FormLabel"
                    android:text="@string/location" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FormField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ui_enter_location"
                        android:inputType="textPostalAddress"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- Card 2: condition + notes -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">
                <TextView
                    style="@style/FormLabel"
                    android:layout_marginTop="0dp"
                    android:text="@string/condition" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCondition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="0dp"
                    app:singleSelection="true">
                    <com.google.android.material.chip.Chip
                        style="@style/ConditionChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/conditionNew"
                        android:text="@string/ui_new_sealed" />
                    <com.google.android.material.chip.Chip
                        style="@style/ConditionChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/conditionGood"
                        android:text="@string/ui_good_condition" />
                    <com.google.android.material.chip.Chip
                        style="@style/ConditionChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/conditionUsed"
                        android:text="@string/ui_used" />
                    <com.google.android.material.chip.Chip
                        style="@style/ConditionChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/conditionRepair"
                        android:text="@string/ui_needs_repair_parts_only" />
                </com.google.android.material.chip.ChipGroup>
                <TextView
                    style="@style/FormLabel"
                    android:layout_marginTop="24dp"
                    android:text="@string/ui_description_issues_notes_nrecommendations" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FormField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="@string/ui_example_needs_lcd_replacement"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- Card 3: photos -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">
                <TextView
                    style="@style/FormLabel"
                    android:layout_marginTop="0dp"
                    android:text="@string/ui_photos_of_your_item" />
                <LinearLayout
                    android:id="@+id/btnAddPhotos"
                    android:layout_width="145dp"
                    android:layout_height="145dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="48dp"
                    android:background="@drawable/bg_photo_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/imgPhotoPreview"
                        android:layout_width="110dp"
                        android:layout_height="100dp"
                        android:scaleType="fitCenter"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_photo_camera" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/ui_add_photos"
                        android:textColor="@android:color/black" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- Actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublish"
            style="@style/ActionButton"
            android:layout_marginTop="24dp"
            android:text="@string/ui_publish_listing"
            app:icon="@drawable/ic_send" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDraft"
            style="@style/ActionButton"
            android:text="@string/ui_save_as_draft"
            app:icon="@drawable/ic_inventory" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/ActionButton.Outlined"
            android:text="@string/cancel"
            app:icon="@drawable/ic_close" />
    </LinearLayout>
</ScrollView>
