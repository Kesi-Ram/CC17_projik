<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginHorizontal="24dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_nav_pill"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:elevation="8dp"
    android:baselineAligned="false">
    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/navHomeIcon"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_home" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/home"
            android:textColor="@color/ink"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/navMarket"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/navMarketIcon"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_market" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/market"
            android:textColor="@color/ink"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/navSell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/navSellIcon"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_sell" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sell"
            android:textColor="@color/ink"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/navTrade"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/navTradeIcon"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_trade" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/trade"
            android:textColor="@color/ink"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/navMaps"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/navMapsIcon"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_location" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/maps"
            android:textColor="@color/ink"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
