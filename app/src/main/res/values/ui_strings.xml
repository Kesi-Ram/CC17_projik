    <string name="guide_trade_step_1_title">Browse &amp; Find an Item</string>
    <string name="guide_trade_step_1_description">Scroll through the marketplace on the Home screen. Use category filters or search to find an item you want.</string>
    <string name="guide_trade_step_2_title">Open Item Details</string>
    <string name="guide_trade_step_2_description">Tap on any listing card to view the full item details — price, condition, description, and seller info.</string>
    <string name="guide_trade_step_3_title">Tap \"Propose a Trade\"</string>
    <string name="guide_trade_step_3_description">On the item detail page, tap the \"Propose a Trade\" button at the bottom of the screen.</string>
    <string name="guide_trade_step_4_title">Fill in Your Item Details</string>
    <string name="guide_trade_step_4_description">Enter your item\'s title, description, and condition. This is the item you are offering in exchange.</string>
    <string name="guide_trade_step_5_title">Choose a Photo</string>
    <string name="guide_trade_step_5_description">Tap Choose or replace photo to select an item photo from your device. Photos are optional.</string>
    <string name="guide_trade_step_6_title">Save Your Proposal</string>
    <string name="guide_trade_step_6_description">Fill in the form and tap Save Trade Proposal. View your offer and its status in the Trade tab. This prototype stores trades on this device.</string>
    <string name="guide_sell_step_1_title">Tap Sell</string>
    <string name="guide_sell_step_1_description">Open the Sell tab from the bottom navigation bar.</string>
    <string name="guide_sell_step_2_title">Add Item Details</string>
    <string name="guide_sell_step_2_description">Enter a title, description, price, and condition for your gadget.</string>
    <string name="guide_sell_step_3_title">Add a Photo</string>
    <string name="guide_sell_step_3_description">Choose a clear photo from your device so buyers can see your item.</string>
    <string name="guide_sell_step_4_title">Publish Your Listing</string>
    <string name="guide_sell_step_4_description">Tap Publish to save your item to the marketplace on this device.</string>
